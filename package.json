{
  "name": "assistant-bridge-desktop",
  "version": "1.0.0",
  "description": "Desktop assistant with web bridge connection",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "create-zip": "node scripts/create-zip.js"
  },
  "keywords": ["assistant", "bridge", "desktop", "electron"],
  "author": "Assistant Bridge Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "socket.io": "^4.7.5",
    "express": "^4.18.2",
    "archiver": "^6.0.1"
  },
  "build": {
    "appId": "com.assistantbridge.desktop",
    "productName": "Assistant Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}